SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only; used for the Marktplaats ad text. OPENAI_MODEL is optional.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=
# Server-only; WooCommerce web shop sync (docs/woocommerce-sync.md). Leave empty to switch it off.
WOOCOMMERCE_URL=https://woonwarmer.nl
WOOCOMMERCE_CONSUMER_KEY=ck_...
WOOCOMMERCE_CONSUMER_SECRET=cs_...
# Server-only; Vercel Cron sends it to /api/cron/* (production only). Random, at least 16 characters.
CRON_SECRET=
# Server-only; Supabase secret key (sb_secret_...), bypasses RLS. Only used by the WooCommerce order
# webhook, which has no signed-in user. Never NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=
# Server-only; the secret entered on the WooCommerce order webhooks (docs/woocommerce-sync.md).
WOOCOMMERCE_WEBHOOK_SECRET=
